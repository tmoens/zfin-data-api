# ============================================================================
# zfin-data-api — DEPLOYMENT configuration (sample)
# ============================================================================
#
# In PRODUCTION this file lives at /etc/zfin-data-api/zfin-data-api.env — OUTSIDE the
# code checkout — owned by the service user and chmod 600. A deploy is `git pull` plus a
# rebuild, and keeping the file elsewhere means a deploy structurally cannot touch the
# database password.
#
# In DEVELOPMENT, copy this file and point the server at it:
#     cp environments/sample.env environments/zfin-data-api.env
#     export ZFIN_API_CONFIG_DIR=environments
# (environments/ is gitignored except for this sample.)
#
# THIS LIST IS EXHAUSTIVE. The keys below are the only ones the server accepts; anything
# else fails validation at startup and names itself. So a key that is not here does
# nothing, and a typo stops the server rather than being ignored.
#
# Six values have no default and must be set: PORT, PUBLIC_URL, DB_NAME, DB_USER,
# DB_PASSWORD, and the two ZFIN_*_URL values. Everything else may be omitted to take the
# default noted against it.

# One of: production, development, test.
NODE_ENV=production

# The port this server listens on. On a host shared with other services, check what is
# already taken:  ss -ltn
PORT=3480

# The interface to bind. Default 127.0.0.1 — loopback only, because Caddy runs on the same
# host and is the only thing that should reach this process directly. Set 0.0.0.0 only if
# you genuinely mean to expose it, and know that your firewall is then the only thing
# standing in front of an API that has no authentication.
HOST=127.0.0.1

# This API's own public base URL. Used only by GET / to describe its own endpoints.
PUBLIC_URL=https://zfin-api.example.org

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The RUNTIME credential: SELECT/INSERT/UPDATE/DELETE on this database and nothing more.
# Schema changes are a deploy-time action on the admin plane (doadmin), never the app's.
DB_NAME=zfin_data
DB_USER=zfin_data
DB_PASSWORD=some-strong-password
# DO Managed MySQL 8 speaks TLS on 25060; a local container is plaintext on 3306.
DB_HOST=localhost
DB_PORT=3306
# Path to a CA certificate FILE when the DB requires verified TLS (DO Managed MySQL 8 in
# production — download it from the DO console). Leave unset for a local plaintext
# connection.
#DB_SSL_CA=/etc/zfin-data-api/do-db-service.crt

# TypeORM behavior. This is very important:
# !!! Schema changes are applied ONLY via versioned migrations !!!
# migrations happen with: npm run migration:run
# All three default to false. Never ever change the first two.
TYPEORM_SYNC_DATABASE=false
TYPEORM_MIGRATION_RUN=false
TYPEORM_LOG_QUERIES=false

# ---------------------------------------------------------------------------
# The ZFIN source data
# ---------------------------------------------------------------------------
# Where the nightly reload gets its data. Required, with no default: a default pointing at
# zfin.org would mean a misconfigured dev box quietly hammering ZFIN's real download
# endpoints.
ZFIN_MUTATION_URL=https://zfin.org/downloads/features-affected-genes.txt
ZFIN_TRANSGENE_URL=https://zfin.org/downloads/tgInsertions.txt

# While developing, download those two files once and serve them locally instead, so you
# are not repeatedly pulling many megabytes from ZFIN:
#ZFIN_MUTATION_URL=http://localhost:8080/features-affected-genes.txt
#ZFIN_TRANSGENE_URL=http://localhost:8080/tgInsertions.txt

# Rows per INSERT during a reload. Too large and the statement exceeds the server's
# max_allowed_packet. The whole load is roughly 50,000 mutations, and 10,000 at a time is
# about two seconds per batch. Default: 10000.
RECORDS_PER_INSERT=10000

# ---------------------------------------------------------------------------
# Development conveniences
# ---------------------------------------------------------------------------
# Whether GET /mutation/loadFromZfin and /transgene/loadFromZfin may trigger a full reload.
# FALSE IN PRODUCTION, ALWAYS: those routes have no authentication, so anyone who learns
# the URL could drop and rebuild both tables at will. The nightly loader does not use them
# — it calls the services directly — so production has no reason to turn this on.
# Default: false.
ALLOW_LOADING_VIA_API=false

# ---------------------------------------------------------------------------
# Error tracking
# ---------------------------------------------------------------------------
# Sentry DSN. When set, unhandled errors — including a failed nightly load — are reported,
# which is how anyone finds out about a fault in a service nobody is watching. With no DSN
# the server runs normally and reports nothing, which is what you want in dev.
#SENTRY_DSN=
