[Unit]
Description=ZFIN Data loader (nightly reload from zfin.org)
Wants=network-online.target
After=network-online.target

[Service]
# Oneshot, NOT simple: this process loads both datasets and exits. Type=simple would have systemd
# treat the exit as the service stopping and — with any Restart= setting — start it again.
Type=oneshot

# Same runtime identity as the API, and for the same reasons. See zfin-data-api.service.
User=${RUNTIME_USER}
Group=${RUNTIME_USER}

# Not ${APP_DIR} itself: that folder holds several installed versions side by side, plus a
# `current` shortcut pointing at the one that should be running. Running from the shortcut is what
# makes a rollback a matter of repointing it and restarting, with the previous version still intact
# on disk. See deploy/install-release.sh.
WorkingDirectory=${APP_DIR}/current
Environment=ZFIN_API_CONFIG_DIR=/etc/zfin-data-api
ExecStart=${NODE_BIN} dist/loader.js

# The loader exits non-zero when a load fails, so a failure shows up as a failed unit:
#   systemctl status zfin-data-loader      # and `systemctl list-timers` for when it last ran

# ---- Sandbox ----------------------------------------------------------------
# Identical to the API's, minus nothing: this process reaches further out (it fetches from zfin.org)
# and so deserves it at least as much.
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# See the API unit: MemoryDenyWriteExecute would break V8.

[Install]
WantedBy=multi-user.target
