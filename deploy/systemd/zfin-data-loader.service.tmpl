# Generated by deploy/render-config.sh from deploy.conf. Edit deploy.conf and re-render.

[Unit]
Description=ZFIN Data loader (nightly reload from zfin.org)
Wants=network-online.target
After=network-online.target

[Service]
# Oneshot: this loads both datasets and exits. Type=simple would read that exit as a crash.
Type=oneshot
User=${RUNTIME_USER}
Group=${RUNTIME_USER}
WorkingDirectory=${APP_DIR}/current
Environment=ZFIN_API_CONFIG_DIR=/etc/zfin-data-api
ExecStart=${NODE_BIN} dist/loader.js
# It exits non-zero on a failed load, so a failure shows as a failed unit.

# ---- Sandbox — see zfin-data-api.service for the notes on these ----------------
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
