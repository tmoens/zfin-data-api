# Generated by deploy/render-config.sh from deploy.conf. Edit deploy.conf and re-render.

[Unit]
Description=ZFIN Data API (NestJS)
# The database is remote, and there is no local mysql.service to order on.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=${RUNTIME_USER}
Group=${RUNTIME_USER}

# `current` is a symlink the deploy tool repoints at the release that should be running.
WorkingDirectory=${APP_DIR}/current

# A directory, not a file: the app reads and validates the env file itself, so this is
# deliberately not an EnvironmentFile.
Environment=ZFIN_API_CONFIG_DIR=/etc/zfin-data-api

# Must be outside /home — ProtectHome=yes below makes a home directory unreachable from here.
ExecStart=${NODE_BIN} dist/main.js

Restart=on-failure
RestartSec=5
KillMode=process

# ---- Sandbox ----------------------------------------------------------------
NoNewPrivileges=true
UMask=0077
# The service writes nothing to disk — logs go to journald, state to the database — so the whole
# filesystem is read-only and no ReadWritePaths are needed.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Listens above port 1024 and dials the database, so it needs no capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
# AF_UNIX is NOT optional: glibc's resolver reaches systemd-resolved over a unix socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Do NOT add MemoryDenyWriteExecute=true. V8's JIT maps write-then-execute pages, and Node exits
# before running a line.

[Install]
WantedBy=multi-user.target
