[Unit]
Description=Run the ZFIN data loader daily
Requires=zfin-data-loader.service

[Timer]
Unit=zfin-data-loader.service
# 11:00 UTC — carried over from the do1 deployment. That is 04:00 Pacific, comfortably outside
# working hours at every facility that uses this API, and well after ZFIN's own nightly publish.
OnCalendar=*-*-* 11:00:00
# Run on next boot if the machine was down when the timer was due, rather than skipping a day.
Persistent=true
# Spread the start over a few minutes so this is not hitting zfin.org at exactly the same second
# as every other consumer with a round-numbered schedule.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
