[Unit]
Description=Run the ZFIN data loader daily
Requires=zfin-data-loader.service

[Timer]
Unit=zfin-data-loader.service
# 11:00 UTC. Outside working hours at the facilities that use this API, and after ZFIN publishes.
OnCalendar=*-*-* 11:00:00
# Run on next boot if the machine was down when it was due, rather than skipping a day.
Persistent=true
# Avoid hitting zfin.org at the same second as every other round-numbered schedule.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
