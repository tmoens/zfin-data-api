# compiled output
/dist
/node_modules

# Logs
npm-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Deployment configuration holds secrets and is host-specific. In production it lives in
# /etc/zfin-data-api/ and never appears here at all; in development it is your own copy.
# Only the documented sample is tracked.
/environments/*
!/environments/sample.env
/.env

# Host-specific deploy values + whatever render-config.sh produced from them.
/deploy/deploy.conf
/deploy/.rendered

# Built release artifacts (pack-release.sh output).
/dist-releases
